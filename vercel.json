{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "web/out",
  "trailingSlash": true,
  "functions": {
    "api/ask.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/zh/",
      "permanent": false
    }
  ]
}
